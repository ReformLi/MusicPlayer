<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fullscreenLyricsContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:fitsSystemWindows="true">

    <!-- 顶部歌曲信息 -->
    <LinearLayout
        android:id="@+id/topInfoBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="48dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvFullscreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="歌曲标题"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFullscreenArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="艺术家"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 歌词 RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFullscreenLyrics"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/topInfoBar"
        app:layout_constraintBottom_toTopOf="@id/bottomControlBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 自定义滚动进度条（仅在手动滑动时显示） -->
    <View
        android:id="@+id/scrollProgressBar"
        android:layout_width="3dp"
        android:layout_height="40dp"
        android:background="@drawable/scrollbar_thumb"
        android:visibility="gone"
        android:alpha="0.0"
        app:layout_constraintEnd_toEndOf="@id/rvFullscreenLyrics"
        app:layout_constraintTop_toTopOf="@id/rvFullscreenLyrics" />

    <!-- 底部控制栏（缩小按钮尺寸） -->
    <LinearLayout
        android:id="@+id/bottomControlBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnFullscreenPrev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_skip_previous"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#FFFFFFFF"
            android:contentDescription="上一首" />

        <ImageButton
            android:id="@+id/btnFullscreenPlayPause"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:src="@drawable/ic_play"
            android:background="@drawable/play_button_background"
            app:tint="#FF000000"
            android:contentDescription="播放/暂停" />

        <ImageButton
            android:id="@+id/btnFullscreenNext"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_skip_next"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#FFFFFFFF"
            android:contentDescription="下一首" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
