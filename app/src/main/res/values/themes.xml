<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.HpuMusicPlayer" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary: 暖陶土 -->
        <item name="colorPrimary">@color/primary_warm</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_container_warm</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container_warm</item>

        <!-- Secondary: 鼠尾草绿 -->
        <item name="colorSecondary">@color/secondary_sage</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/secondary_container_sage</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container_sage</item>

        <!-- Background: 暖米白 -->
        <item name="android:colorBackground">@color/background_warm_light</item>
        <item name="colorOnBackground">@color/text_primary_warm</item>

        <!-- Surface: 纯白卡片 -->
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary_warm</item>
        <item name="colorSurfaceVariant">@color/surface_variant_warm</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_warm</item>

        <!-- Error -->
        <item name="colorError">@color/error_warm</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorErrorContainer">@color/accent_red</item>
        <item name="colorOnErrorContainer">@color/white</item>

        <!-- Outline -->
        <item name="colorOutline">@color/outline_warm</item>
        <item name="colorOutlineVariant">@color/outline_variant_warm</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/background_warm_light</item>
        <item name="android:navigationBarColor">@color/background_warm_light</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Component accent -->
        <item name="colorAccent">@color/secondary_sage</item>

        <!-- Text appearances -->
        <item name="android:textColorPrimary">@color/text_primary_warm</item>
        <item name="android:textColorSecondary">@color/text_secondary_warm</item>

        <!-- Shape appearances -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.HpuMusicPlayer.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.HpuMusicPlayer.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.HpuMusicPlayer.Large</item>

        <!-- Typography -->
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.HpuMusicPlayer.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.HpuMusicPlayer.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.HpuMusicPlayer.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.HpuMusicPlayer.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.HpuMusicPlayer.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.HpuMusicPlayer.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.HpuMusicPlayer.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.HpuMusicPlayer.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.HpuMusicPlayer.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.HpuMusicPlayer.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.HpuMusicPlayer.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.HpuMusicPlayer.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.HpuMusicPlayer.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.HpuMusicPlayer.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.HpuMusicPlayer.LabelSmall</item>

        <!-- Activity transitions -->
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowEnterTransition">@android:transition/fade</item>
        <item name="android:windowExitTransition">@android:transition/fade</item>
        <item name="android:windowSharedElementEnterTransition">@android:transition/move</item>
        <item name="android:windowSharedElementExitTransition">@android:transition/move</item>
    </style>

    <!-- Shape appearances (unchanged) -->
    <style name="ShapeAppearance.HpuMusicPlayer.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.HpuMusicPlayer.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.HpuMusicPlayer.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Typography (Title weights: 400 → 500, HeadlineMedium: 400 → 500) -->
    <style name="TextAppearance.HpuMusicPlayer.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:textSize">57sp</item>
        <item name="android:textFontWeight" tools:targetApi="p">400</item>
    </style>

    <style name="TextAppearance.HpuMusicPlayer.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:textSize">45sp</item>
        <item name="android:textFontWeight" tools:targetApi="p">400</item>
    </style>

    <style name="TextAppearance.HpuMusicPlayer.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">36sp</item>
        <item name="android:textFontWeight" tools:targetApi="p">400</item>
    </style>

    <style name="TextAppearance.HpuMusicPlayer.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">32sp</item>
        <item name="android:textFontWeight" tools:targetApi="p">400</item>
    </style>

    <style name="TextAppearance.HpuMusicPlayer.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">28sp</item>
        <item name="android:textFontWeight" tools:targetApi="p">500</item>
    </style>

    <style name="TextAppearance.HpuMusicPlayer.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">24sp</item>
        <item name="android:textFontWeight" tools:targetApi="p">400</item>
    </style>

    <style name="TextAppearance.HpuMusicPlayer.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">22sp</item>
        <item name="android:textFontWeight" tools:targetApi="p">500</item>
    </style>

    <style name="TextAppearance.HpuMusicPlayer.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textFontWeight" tools:targetApi="p">500</item>
    </style>

    <style name="TextAppearance.HpuMusicPlayer.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">14sp</item>
        <item name="android:textFontWeight" tools:targetApi="p">500</item>
    </style>

    <style name="TextAppearance.HpuMusicPlayer.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textFontWeight" tools:targetApi="p">400</item>
    </style>

    <style name="TextAppearance.HpuMusicPlayer.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textFontWeight" tools:targetApi="p">400</item>
    </style>

    <style name="TextAppearance.HpuMusicPlayer.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textFontWeight" tools:targetApi="p">400</item>
    </style>

    <style name="TextAppearance.HpuMusicPlayer.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:textFontWeight" tools:targetApi="p">500</item>
    </style>

    <style name="TextAppearance.HpuMusicPlayer.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textFontWeight" tools:targetApi="p">500</item>
    </style>

    <style name="TextAppearance.HpuMusicPlayer.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textFontWeight" tools:targetApi="p">500</item>
    </style>

    <!-- Popup menu theme -->
    <style name="Theme.HpuMusicPlayer.PopupMenu" parent="ThemeOverlay.AppCompat.Dark">
        <item name="android:colorBackground">@color/surface_card</item>
        <item name="android:textColorPrimary">@color/text_primary_warm</item>
        <item name="android:textColorSecondary">@color/text_secondary_warm</item>
    </style>

    <!-- Dialog Animation -->
    <style name="DialogAnimation">
        <item name="android:windowEnterAnimation">@anim/scale_in</item>
        <item name="android:windowExitAnimation">@anim/scale_and_fade_out</item>
    </style>
</resources>
